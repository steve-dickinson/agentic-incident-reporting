# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
LOG_LEVEL=INFO

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Neo4j Configuration
NEO4J_URI=bolt://neo4j:7687  # Internal Docker network (use bolt://localhost:7688 for external)
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here
NEO4J_DATABASE=neo4j

# PostgreSQL Configuration
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=incident_reporting
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here

# GOV.UK Notify Configuration
NOTIFY_API_KEY=your_notify_api_key_here
NOTIFY_EMAIL_TEMPLATE_ID=your_email_template_id
NOTIFY_SMS_TEMPLATE_ID=your_sms_template_id
NOTIFY_TEST_MODE=true

# Agent Configuration
AGENT_MAX_ITERATIONS=10
AGENT_TEMPERATURE=0.0
ENABLE_TRACING=false
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=

# Data Paths
SYNTHETIC_DATA_PATH=/app/data/synthetic
EMBEDDINGS_PATH=/app/data/embeddings
GUIDANCE_DOCS_PATH=/app/data/guidance

# Security
SECRET_KEY=your_secret_key_here_change_in_production
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
